//@version=6
// =============================================================================
// w10 — ETH SHORT-only — Régimen bajista de largo plazo + (ruptura de mínimos | pullback fallido)
//       + filtro de volatilidad + stop Chandelier   (w10 = w9 con el percentil de volatilidad por timeframe)
//
// ÚNICO CAMBIO RESPECTO A w9 (todo lo demás es idéntico; ver W10_resultados.md):
//   Filtro de volatilidad: percentil máximo de ATR% de 75 (igual en todos los TF) pasa a
//     1D 70 | 4H 75 (sin cambio) | 1H 65
//   Efecto: se evitan más entradas en tramos de volatilidad alta (capitulaciones, rebotes violentos).
//   Evidencia (backtest ETHUSDT 2017-08 -> 2026-01, a igual riesgo): 1D PF 1,99 -> 2,20 y OOS +65 % -> +77 %;
//   1H PF 1,87 -> 2,21, DD -21,3 % -> -17,6 % y OOS +65 % -> +80 %. En 4H el cambio NO es robusto (acantilado en 0,65): no se aplica.
//
// Resto de la lógica (heredada de w8/w9):
//   w8 vs w4: multiplicador del stop 1H 3.0 | 4H 3.0 | 1D 2.0
//   w9 vs w8: 1H filtro de extensión 9 ATR + toma parcial 25 % a 1.5 ATR + riesgo 6 %; 1D EMA rápida del pullback 55 (barras de 4h)
// Misma lógica en 1H / 4H / 1D: las longitudes se definen en "barras de 4h" y se escalan por tiempo.
//
// RÉGIMEN: close < EMA(emaLen)   (EMA 600 en barras de 4h ≈ 100 días)
// FILTRO DE VOLATILIDAD: no entrar si ATR% (ATR_eq/close) > percentil volPct de las últimas 750 barras de 4h
// ENTRADA SHORT (al cierre de la barra -> orden a mercado en la apertura siguiente). Vale UNA de dos:
//   A) Ruptura:  close < mínimo de las `lookLen` barras ANTERIORES
//   B) Pullback: close cruza por debajo de la EMA rápida (emaFast) y EMA rápida < EMA de régimen
//   Ambas exigen régimen bajista y haber cargado al menos `emaLen` barras (calentamiento).
// SALIDA (solo stop dinámico; en 1H además toma parcial):
//   stop inicial  = close_señal + mult * ATR_eq
//   trailing      = min(stop previo, mínimo_desde_entrada + mult * ATR_eq), solo baja
// TAMAÑO: riesgo fijo por operación (% del equity) / distancia al stop, con tope de apalancamiento.
//
// ATR_eq = ATR(atrLen) * sqrt(f): normaliza la volatilidad de cada timeframe a "equivalente 4h".
//
// NOTAS DE USO
//  * Validado solo en ETHUSDT 1H, 4H y 1D. Otros timeframes/activos: no probado.
//  * Riesgo por operación (presupuesto de DD <= 25 % in-sample, como w9): 1H 6 %, 4H 4 %, 1D 5 %.
//    Subirlo escala rentabilidad y drawdown a la vez.
//  * CARTERA (opcional): las tres temporalidades tienen correlación diaria 0,47-0,71, así que repartir el capital
//    (1/3 por gráfico, una instancia de la estrategia en cada gráfico con su propio capital inicial) reduce el DD
//    y permite subir el riesgo. Ver W10_resultados.md (lambda 1.5: 1D 7.5 % | 4H 6 % | 1H 9 %).
//  * Las EMAs son recursivas (equivalentes a pandas ewm(adjust=False)).
//  * Costes: comisión 0,05 % + slippage 0,03 % por lado = 0,08 % por lado, modelado como
//    comisión porcentual (slippage=0). NO uses slippage en ticks.
//  * Funding de perpetuos NO incluido. Ejecución: señal al cierre, entrada en la apertura siguiente.
//  * Toma parcial en TradingView: el emulador puede resolver distinto que el backtest Python si stop y objetivo
//    coinciden en la misma barra (el backtest da prioridad al stop).
//  * Este script no se ha podido compilar/ejecutar en TradingView desde el entorno de análisis: es w9 con tres inputs
//    nuevos. Verifícalo en tu gráfico antes de usarlo.
// =============================================================================
strategy("w10 - ETH SHORT Breakdown+Pullback+Regime+VolFilter", overlay=true,
     initial_capital=10000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.08,
     slippage=0, margin_short=50,
     process_orders_on_close=false, calc_on_every_tick=false)

// ------------------------------- Parámetros ----------------------------------
emaBase  = input.int(600,   "EMA de régimen (barras de 4h)", minval=10, group="Estrategia")
lookBase = input.int(45,    "Ruptura: mínimo de N barras (barras de 4h)", minval=5, group="Estrategia")
fastBase = input.int(40,    "EMA rápida del pullback 1H/4H (barras de 4h)", minval=5, group="Estrategia")
fastD1   = input.int(55,    "EMA rápida del pullback 1D (barras de 4h)", minval=5, group="Estrategia")
atrBase  = input.int(14,    "ATR (barras de 4h)", minval=2, group="Estrategia")
multH1   = input.float(3.0, "Multiplicador ATR del stop 1H", minval=0.5, step=0.25, group="Estrategia")
multH4   = input.float(3.0, "Multiplicador ATR del stop 4H", minval=0.5, step=0.25, group="Estrategia")
multD1   = input.float(2.0, "Multiplicador ATR del stop 1D", minval=0.5, step=0.25, group="Estrategia")

volBase  = input.int(750,   "Filtro vol: ventana (barras de 4h)", minval=50, group="Estrategia")
volPctH1 = input.float(65,  "Filtro vol 1H: percentil máximo de ATR%", minval=50, maxval=100, step=5, group="Estrategia")
volPctH4 = input.float(75,  "Filtro vol 4H: percentil máximo de ATR%", minval=50, maxval=100, step=5, group="Estrategia")
volPctD1 = input.float(70,  "Filtro vol 1D: percentil máximo de ATR%", minval=50, maxval=100, step=5, group="Estrategia")

riskH1   = input.float(6.0, "Riesgo por operación 1H (% equity)", minval=0.1, maxval=15, step=0.25, group="Riesgo")
riskH4   = input.float(4.0, "Riesgo por operación 4H (% equity)", minval=0.1, maxval=15, step=0.25, group="Riesgo")
riskD1   = input.float(5.0, "Riesgo por operación 1D (% equity)", minval=0.1, maxval=15, step=0.25, group="Riesgo")
maxLev   = input.float(2.0, "Apalancamiento máximo (nocional/equity)", minval=0.5, step=0.5, group="Riesgo")

extH1    = input.float(9.0, "Filtro extensión 1H: máx (EMA régimen - close)/ATR_eq (0 = off)", minval=0, step=0.5, group="Mejoras w9")
extH4    = input.float(0.0, "Filtro extensión 4H (0 = off)", minval=0, step=0.5, group="Mejoras w9")
extD1    = input.float(0.0, "Filtro extensión 1D (0 = off)", minval=0, step=0.5, group="Mejoras w9")
tpPctH1  = input.float(25.0, "Toma parcial 1H: % de la posición (0 = off)", minval=0, maxval=90, step=5, group="Mejoras w9")
tpPctH4  = input.float(0.0,  "Toma parcial 4H: % de la posición (0 = off)", minval=0, maxval=90, step=5, group="Mejoras w9")
tpPctD1  = input.float(0.0,  "Toma parcial 1D: % de la posición (0 = off)", minval=0, maxval=90, step=5, group="Mejoras w9")
tpMult   = input.float(1.5,  "Toma parcial: beneficio en ATR_eq", minval=0.5, step=0.25, group="Mejoras w9")

startT   = input.time(timestamp("2017-08-17 00:00 +0000"), "Inicio del test", group="Ventana de test")
endT     = input.time(timestamp("2026-12-31 23:59 +0000"), "Fin del test",    group="Ventana de test")

showDiag = input.bool(true, "Mostrar panel de diagnóstico", group="Diagnóstico")

// --------------------------- Escalado por timeframe --------------------------
f       = 14400.0 / timeframe.in_seconds()            // 1H -> 4 | 4H -> 1 | 1D -> 1/6
emaLen  = int(math.floor(emaBase  * f + 0.5))
lookLen = int(math.floor(lookBase * f + 0.5))
fastLen = int(math.floor((timeframe.in_seconds() == 86400 ? fastD1 : fastBase) * f + 0.5))
atrLen  = math.max(int(math.floor(atrBase * f + 0.5)), 14)   // suelo de 14 barras (en 1D la escala daría 2)
volLen  = int(math.floor(volBase * f + 0.5))
riskPct = timeframe.in_seconds() == 86400 ? riskD1 : timeframe.in_seconds() == 14400 ? riskH4 : riskH1
mult    = timeframe.in_seconds() == 86400 ? multD1 : timeframe.in_seconds() == 14400 ? multH4 : multH1
volPct  = timeframe.in_seconds() == 86400 ? volPctD1 : timeframe.in_seconds() == 14400 ? volPctH4 : volPctH1
extMax  = timeframe.in_seconds() == 86400 ? extD1 : timeframe.in_seconds() == 14400 ? extH4 : extH1
tpPct   = timeframe.in_seconds() == 86400 ? tpPctD1 : timeframe.in_seconds() == 14400 ? tpPctH4 : tpPctH1

// Guarda: w10 solo está validada en 1H, 4H y 1D.
if not (timeframe.in_seconds() == 3600 or timeframe.in_seconds() == 14400 or timeframe.in_seconds() == 86400)
    runtime.error("w10 solo está validada en 1H, 4H y 1D. Cambia el timeframe del gráfico a uno de esos tres.")

// --------------------------------- Indicadores -------------------------------
// EMAs recursivas, sembradas con el primer cierre (== pandas ewm(adjust=False))
alphaT   = 2.0 / (emaLen + 1)
alphaF   = 2.0 / (fastLen + 1)
var float emaTrend = na
var float emaFast  = na
emaTrend := na(emaTrend) ? close : alphaT * close + (1 - alphaT) * emaTrend
emaFast  := na(emaFast)  ? close : alphaF * close + (1 - alphaF) * emaFast

atrEq    = ta.atr(atrLen) * math.sqrt(f)
prevLow  = ta.lowest(low, lookLen)[1]                 // mínimo de las N barras ANTERIORES (sin lookahead)

// Filtro de volatilidad: ATR% frente a su percentil (interpolación lineal, == pandas quantile) de las volLen barras previas
atrPct   = atrEq / close
volThr   = ta.percentile_linear_interpolation(atrPct, volLen, volPct)
volReady = bar_index >= atrLen + volLen - 1               // ventana completa de ATR% disponible
volOk    = not volReady or not (atrPct > volThr[1])

inWindow = time >= startT and time <= endT
warmedUp = bar_index >= emaLen                        // no operar hasta que la EMA de régimen lleve emaLen barras
regime   = close < emaTrend
sigBreak = regime and close < prevLow
sigPull  = regime and emaFast < emaTrend and close < emaFast and close[1] >= emaFast[1]
extOk    = extMax <= 0 or ((emaTrend - close) / atrEq <= extMax)   // no vender movimientos ya muy extendidos bajo la EMA de régimen
signal   = inWindow and warmedUp and volOk and extOk and not na(atrEq) and not na(prevLow) and (sigBreak or sigPull)

// ------------------------------ Gestión del stop -----------------------------
var float stopPx   = na
var float lowSince = na
var int   nSignals = 0

if strategy.position_size < 0
    lowSince := na(lowSince) ? low : math.min(lowSince, low)
    stopPx   := math.min(stopPx, lowSince + mult * atrEq)
    strategy.exit("SL", "Short", stop=stopPx)

// ---------------------------------- Entrada ----------------------------------
if signal and strategy.position_size == 0
    float dist     = mult * atrEq / close
    float notional = math.min(maxLev * strategy.equity, (riskPct / 100.0) * strategy.equity / dist)
    float qty      = notional / close
    stopPx   := close + mult * atrEq
    lowSince := na
    nSignals += 1
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("SL", "Short", stop=stopPx)         // se activa en cuanto se ejecuta la entrada
    if tpPct > 0
        strategy.exit("TP", "Short", qty_percent=tpPct, limit=close - tpMult * atrEq)   // toma parcial (una sola vez)

// Cierre al final de la ventana de test
if time > endT and strategy.position_size < 0
    strategy.close_all(comment="Fin ventana")

// ---------------------------------- Gráficos ---------------------------------
plot(emaTrend, "EMA régimen", color=color.new(color.orange, 0), linewidth=2)
plot(emaFast,  "EMA rápida",  color=color.new(color.aqua, 30),  linewidth=1)
plot(strategy.position_size < 0 ? stopPx : na, "Stop trailing", color=color.red, style=plot.style_linebr, linewidth=2)
plotshape(signal and strategy.position_size == 0 and sigBreak, title="Señal ruptura", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
plotshape(signal and strategy.position_size == 0 and not sigBreak, title="Señal pullback", style=shape.triangledown, location=location.abovebar, color=color.purple, size=size.tiny)

// ------------------------------ Panel de diagnóstico -------------------------
var int   firstT = time
var table diag   = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 15), border_width=1)

diagRow(table t, int row, string label, string value) =>
    table.cell(t, 0, row, label, text_color=color.white,  text_halign=text.align_left, text_size=size.small)
    table.cell(t, 1, row, value, text_color=color.yellow, text_halign=text.align_left, text_size=size.small)

if showDiag and barstate.islast
    diagRow(diag, 0, "w10 · diagnóstico", syminfo.tickerid)
    diagRow(diag, 1, "Timeframe (s)", str.tostring(timeframe.in_seconds()))
    diagRow(diag, 2, "EMA / rápida / ruptura / ATR", str.format("{0} / {1} / {2} / {3}", emaLen, fastLen, lookLen, atrLen))
    diagRow(diag, 3, "Barras cargadas", str.tostring(bar_index + 1))
    diagRow(diag, 4, "Primera barra", str.format_time(firstT, "yyyy-MM-dd"))
    diagRow(diag, 5, "Señales SHORT", str.tostring(nSignals))
    diagRow(diag, 6, "Operaciones cerradas", str.tostring(strategy.closedtrades))
    diagRow(diag, 7, "Posición abierta", str.tostring(strategy.position_size))
    diagRow(diag, 8, "Ahora: régimen | ruptura | pullback", str.tostring(regime) + " | " + str.tostring(sigBreak) + " | " + str.tostring(sigPull))
    diagRow(diag, 9, "Vol OK | riesgo % | mult | percentil vol | ext | TP%", str.tostring(volOk) + " | " + str.tostring(riskPct) + " | " + str.tostring(mult) + " | " + str.tostring(volPct) + " | " + str.tostring(extMax) + " | " + str.tostring(tpPct))
