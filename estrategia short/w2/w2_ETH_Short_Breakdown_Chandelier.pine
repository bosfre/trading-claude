//@version=6
// =============================================================================
// w2 — ETH SHORT-only — Breakdown de rango en régimen bajista de largo plazo + stop Chandelier
// (w2 = w1 con UNA modificación: EMA de régimen 200 -> 600, en barras de 4h)
// Misma lógica en 15m / 1h / 4h: las longitudes se escalan por tiempo
// (parámetros definidos en "barras de 4h" y convertidos a barras del gráfico).
//
// ENTRADA (al cierre de la barra de señal -> orden a mercado en la apertura siguiente):
//   close < EMA(emaLen)                      (régimen bajista de largo plazo; EMA 600 en barras de 4h)
//   y haber cargado al menos `emaLen` barras (calentamiento de la EMA)
//   close < mínimo de las `lookLen` barras ANTERIORES (ruptura a la baja)
// SALIDA (solo stop dinámico, sin take profit):
//   stop inicial  = close_señal + mult * ATR_eq
//   trailing      = min(stop previo, mínimo_desde_entrada + mult * ATR_eq), solo baja
// TAMAÑO: riesgo fijo por operación (% del equity) / distancia al stop, con tope de apalancamiento.
//
// ATR_eq = ATR(atrLen) * sqrt(f): normaliza la volatilidad de barras cortas a "equivalente 4h".
//
// NOTAS DE USO
//  * Validado solo en ETHUSDT 15m, 1h y 4h. En otros timeframes/activos no está probado.
//  * 15m necesita muchas barras (EMA = 9600 barras de calentamiento). Para cubrir años enteros en 15m
//    usa Deep Backtesting (plan Premium); con el historial normal solo verás unos meses.
//  * Costes: comisión 0,05 % + slippage 0,03 % por lado = 0,08 % por lado, modelado como
//    comisión porcentual (slippage=0). NO uses slippage en ticks: es un importe fijo y con ETH a
//    100-300 USD (2018-2019) equivale a 0,3-1 % por lado, lo que destruye parte del edge.
//  * Funding de perpetuos NO incluido. Ejecución: señal al cierre, entrada en la apertura siguiente.
// =============================================================================
strategy("w2 - ETH SHORT Breakdown+Chandelier+Regime", overlay=true,
     initial_capital=10000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.08,
     slippage=0, margin_short=50,
     process_orders_on_close=false, calc_on_every_tick=false)

// ------------------------------- Parámetros ----------------------------------
emaBase  = input.int(600,   "EMA de régimen (barras de 4h)", minval=10, group="Estrategia")
lookBase = input.int(75,    "Ruptura: mínimo de N barras (barras de 4h)", minval=5, group="Estrategia")
atrBase  = input.int(14,    "ATR (barras de 4h)", minval=2, group="Estrategia")
mult     = input.float(3.5, "Multiplicador ATR del stop", minval=0.5, step=0.25, group="Estrategia")

riskPct  = input.float(3.0, "Riesgo por operación (% equity)", minval=0.1, maxval=10, step=0.25, group="Riesgo")
maxLev   = input.float(2.0, "Apalancamiento máximo (nocional/equity)", minval=0.5, step=0.5, group="Riesgo")

startT   = input.time(timestamp("2017-08-17 00:00 +0000"), "Inicio del test", group="Ventana de test")
endT     = input.time(timestamp("2026-12-31 23:59 +0000"), "Fin del test",    group="Ventana de test")

showDiag = input.bool(true, "Mostrar panel de diagnóstico", group="Diagnóstico")

// --------------------------- Escalado por timeframe --------------------------
f      = 14400.0 / timeframe.in_seconds()             // 4h -> 1 | 1h -> 4 | 15m -> 16
emaLen = int(math.round(emaBase  * f))
lookLen= int(math.round(lookBase * f))
atrLen = int(math.round(atrBase  * f))

// Guarda: w2 solo está validada en 15m, 1h y 4h.
//  * Menos de 15m: las ventanas escaladas pasan de decenas de miles de barras y superan los límites de Pine.
//  * Más de 4h (p. ej. 1D): las longitudes escaladas se degeneran (ATR de 2 barras) y
//    la estrategia deja de ser la que se probó.
if timeframe.in_seconds() < 900 or timeframe.in_seconds() > 14400
    runtime.error("w2 solo está validada en 15m, 1h y 4h. Cambia el timeframe del gráfico a uno de esos tres.")

// --------------------------------- Indicadores -------------------------------
// EMA recursiva manual (equivale a pandas ewm(adjust=False), sembrada con el primer cierre).
// ta.ema() no sirve aquí: en 15m la longitud es 9600 barras y Pine limita ta.ema a 5000.
alphaE   = 2.0 / (emaLen + 1)
var float emaTrend = na
emaTrend := na(emaTrend) ? close : alphaE * close + (1 - alphaE) * emaTrend
atrEq    = ta.atr(atrLen) * math.sqrt(f)
prevLow  = ta.lowest(low, lookLen)[1]                 // mínimo de las N barras ANTERIORES (sin lookahead)

inWindow = time >= startT and time <= endT
warmedUp = bar_index >= emaLen                       // no operar hasta que la EMA lleve emaLen barras
signal   = inWindow and warmedUp and not na(emaTrend) and not na(atrEq) and not na(prevLow) and close < emaTrend and close < prevLow

// ------------------------------ Gestión del stop -----------------------------
var float stopPx = na
var float lowSince = na
var int   nSignals = 0

if strategy.position_size < 0
    lowSince := na(lowSince) ? low : math.min(lowSince, low)
    stopPx   := math.min(stopPx, lowSince + mult * atrEq)
    strategy.exit("SL", "Short", stop=stopPx)

// ---------------------------------- Entrada ----------------------------------
if signal and strategy.position_size == 0
    float dist     = mult * atrEq / close
    float notional = math.min(maxLev * strategy.equity, (riskPct / 100.0) * strategy.equity / dist)
    float qty      = notional / close
    stopPx   := close + mult * atrEq
    lowSince := na
    nSignals += 1
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("SL", "Short", stop=stopPx)         // se activa en cuanto se ejecuta la entrada

// Cierre al final de la ventana de test
if time > endT and strategy.position_size < 0
    strategy.close_all(comment="Fin ventana")

// ---------------------------------- Gráficos ---------------------------------
plot(emaTrend, "EMA tendencia", color=color.new(color.orange, 0), linewidth=2)
plot(strategy.position_size < 0 ? stopPx : na, "Stop trailing", color=color.red, style=plot.style_linebr, linewidth=2)
plotshape(signal and strategy.position_size == 0, title="Señal SHORT", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

// ------------------------------ Panel de diagnóstico -------------------------
// Sirve para ver de un vistazo por qué no hay operaciones (histórico cargado, señales, etc.).
var int   firstT = time
var table diag   = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 15), border_width=1)

diagRow(table t, int row, string label, string value) =>
    table.cell(t, 0, row, label, text_color=color.white,  text_halign=text.align_left, text_size=size.small)
    table.cell(t, 1, row, value, text_color=color.yellow, text_halign=text.align_left, text_size=size.small)

if showDiag and barstate.islast
    diagRow(diag, 0, "w2 · diagnóstico", syminfo.tickerid)
    diagRow(diag, 1, "Timeframe (s)", str.tostring(timeframe.in_seconds()))
    diagRow(diag, 2, "EMA / ruptura / ATR (barras)", str.format("{0} / {1} / {2}", emaLen, lookLen, atrLen))
    diagRow(diag, 3, "Barras cargadas", str.tostring(bar_index + 1))
    diagRow(diag, 4, "Primera barra", str.format_time(firstT, "yyyy-MM-dd"))
    diagRow(diag, 5, "Señales SHORT", str.tostring(nSignals))
    diagRow(diag, 6, "Operaciones cerradas", str.tostring(strategy.closedtrades))
    diagRow(diag, 7, "Posición abierta", str.tostring(strategy.position_size))
    diagRow(diag, 8, "Ahora: close<EMA | close<mín", str.tostring(close < emaTrend) + " | " + str.tostring(close < prevLow))
