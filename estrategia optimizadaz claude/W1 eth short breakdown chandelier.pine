//@version=6
// =============================================================================
// ETH SHORT-only — Breakdown de rango en tendencia bajista + stop Chandelier
// Misma lógica en 15m / 1h / 4h: las longitudes se escalan por tiempo
// (parámetros definidos en "barras de 4h" y convertidos a barras del gráfico).
//
// ENTRADA (al cierre de la barra de señal -> orden a mercado en la apertura siguiente):
//   close < EMA(emaLen)                      (tendencia bajista)
//   close < mínimo de las `lookLen` barras ANTERIORES (ruptura a la baja)
// SALIDA (solo stop dinámico, sin take profit):
//   stop inicial  = close_señal + mult * ATR_eq
//   trailing      = min(stop previo, mínimo_desde_entrada + mult * ATR_eq), solo baja
// TAMAÑO: riesgo fijo por operación (% del equity) / distancia al stop, con tope de apalancamiento.
//
// ATR_eq = ATR(atrLen) * sqrt(f): normaliza la volatilidad de barras cortas a "equivalente 4h".
//
// NOTAS DE USO
//  * Validado solo en ETHUSDT 15m, 1h y 4h. En otros timeframes/activos no está probado.
//  * 15m necesita muchas barras (EMA = 3200 barras). Para cubrir años enteros en 15m
//    usa Deep Backtesting (plan Premium); con el historial normal solo verás unos meses.
//  * `slippage` en Pine se da en TICKS (fijo). 100 ticks = 1,00 USD ≈ 0,03 % con ETH ≈ 3000.
//    Ajústalo si el precio es muy distinto.
//  * Funding de perpetuos NO incluido. Ejecución: señal al cierre, entrada en la apertura siguiente.
// =============================================================================
strategy("ETH SHORT Breakdown+Chandelier", overlay=true,
     initial_capital=10000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=100, margin_short=50,
     process_orders_on_close=false, calc_on_every_tick=false)

// ------------------------------- Parámetros ----------------------------------
emaBase  = input.int(200,   "EMA de tendencia (barras de 4h)", minval=10, group="Estrategia")
lookBase = input.int(75,    "Ruptura: mínimo de N barras (barras de 4h)", minval=5, group="Estrategia")
atrBase  = input.int(14,    "ATR (barras de 4h)", minval=2, group="Estrategia")
mult     = input.float(3.5, "Multiplicador ATR del stop", minval=0.5, step=0.25, group="Estrategia")

riskPct  = input.float(3.0, "Riesgo por operación (% equity)", minval=0.1, maxval=10, step=0.25, group="Riesgo")
maxLev   = input.float(2.0, "Apalancamiento máximo (nocional/equity)", minval=0.5, step=0.5, group="Riesgo")

startT   = input.time(timestamp("2017-08-17 00:00 +0000"), "Inicio del test", group="Ventana de test")
endT     = input.time(timestamp("2026-12-31 23:59 +0000"), "Fin del test",    group="Ventana de test")

// --------------------------- Escalado por timeframe --------------------------
f      = 14400.0 / timeframe.in_seconds()             // 4h -> 1 | 1h -> 4 | 15m -> 16
emaLen = int(math.round(emaBase  * f))
lookLen= int(math.round(lookBase * f))
atrLen = int(math.round(atrBase  * f))

// --------------------------------- Indicadores -------------------------------
emaTrend = ta.ema(close, emaLen)
atrEq    = ta.atr(atrLen) * math.sqrt(f)
prevLow  = ta.lowest(low, lookLen)[1]                 // mínimo de las N barras ANTERIORES (sin lookahead)

inWindow = time >= startT and time <= endT
signal   = inWindow and not na(emaTrend) and not na(atrEq) and not na(prevLow) and close < emaTrend and close < prevLow

// ------------------------------ Gestión del stop -----------------------------
var float stopPx = na
var float lowSince = na

if strategy.position_size < 0
    lowSince := na(lowSince) ? low : math.min(lowSince, low)
    stopPx   := math.min(stopPx, lowSince + mult * atrEq)
    strategy.exit("SL", "Short", stop=stopPx)

// ---------------------------------- Entrada ----------------------------------
if signal and strategy.position_size == 0
    float dist     = mult * atrEq / close
    float notional = math.min(maxLev * strategy.equity, (riskPct / 100.0) * strategy.equity / dist)
    float qty      = notional / close
    stopPx   := close + mult * atrEq
    lowSince := na
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("SL", "Short", stop=stopPx)         // se activa en cuanto se ejecuta la entrada

// Cierre al final de la ventana de test
if time > endT and strategy.position_size < 0
    strategy.close_all(comment="Fin ventana")

// ---------------------------------- Gráficos ---------------------------------
plot(emaTrend, "EMA tendencia", color=color.new(color.orange, 0), linewidth=2)
plot(strategy.position_size < 0 ? stopPx : na, "Stop trailing", color=color.red, style=plot.style_linebr, linewidth=2)
plotshape(signal and strategy.position_size == 0, title="Señal SHORT", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
